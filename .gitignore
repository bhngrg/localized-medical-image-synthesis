# ============================================================
# macOS
# ============================================================
.DS_Store

# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class

# ============================================================
# Virtual environments
# ============================================================
.venv/
venv/
env/

# ============================================================
# Jupyter
# ============================================================
.ipynb_checkpoints/

# ============================================================
# Dataset
# ============================================================
data/*
!data/README.md
!data/folders.example.yaml

# ============================================================
# Checkpoints
# ============================================================
checkpoints/*
!checkpoints/.gitkeep

# ============================================================
# Outputs
# ============================================================
outputs/*
!outputs/.gitkeep

# ============================================================
# Logs
# ============================================================

# Keep experiment logs under version control
!logs/
!logs/**/*.log
!logs/**/*.err

# Keep nnU-Net screening logs under version control
!screening/brats_nnunet/logs/
!screening/brats_nnunet/logs/*.log
!screening/brats_nnunet/logs/*.err
# Recomputable BR-LoRA compatibility caches
training_only_compatibility_cache.npz

# Downstream segmentation job logs
# Ignore miscellaneous runtime logs by default. Curated logs are moved
# into the organized subdirectories below and retained as provenance.
downstream_evaluation/logs/*

!downstream_evaluation/logs/training/
downstream_evaluation/logs/training/*
!downstream_evaluation/logs/training/real_only/
!downstream_evaluation/logs/training/real_only/**
!downstream_evaluation/logs/training/posterior_mean/
!downstream_evaluation/logs/training/posterior_mean/**
!downstream_evaluation/logs/training/posterior_sampling/
!downstream_evaluation/logs/training/posterior_sampling/**

!downstream_evaluation/logs/evaluation/
downstream_evaluation/logs/evaluation/*
!downstream_evaluation/logs/evaluation/ucsf_pdgm/
!downstream_evaluation/logs/evaluation/ucsf_pdgm/**

!downstream_evaluation/logs/reproducibility/
!downstream_evaluation/logs/reproducibility/**
